{
  "name": "vaultspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "description": "Open-source, self-hosted secure Virtual Data Room (VDR) platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/valcros/vaultspace.git"
  },
  "scripts": {
    "dev": "next dev",
    "dev:standalone": "DEPLOYMENT_MODE=standalone next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "DEPLOYMENT_MODE=standalone next start",
    "lint": "eslint src next.config.js eslint.config.mjs",
    "lint:fix": "eslint src next.config.js eslint.config.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:standalone": "DEPLOYMENT_MODE=standalone vitest run --config vitest.integration.config.ts",
    "test:integration:rls": "VAULTSPACE_CONCURRENCY_TEST_DATABASE=true ENABLE_RLS=true DEPLOYMENT_MODE=standalone vitest run --config vitest.integration.config.ts tests/integration/rls.test.ts tests/integration/password-reset-provider-final-evidence.test.ts tests/integration/authorization-room-scope.test.ts tests/integration/link-admission-policy.test.ts tests/integration/bootstrap-login-candidate.test.ts tests/integration/bootstrap-session-resolve.test.ts tests/integration/bootstrap-organization-resolve.test.ts tests/integration/bootstrap-session-mutation.test.ts tests/integration/bootstrap-password-reset-capability.test.ts tests/integration/bootstrap-password-reset-issuance.test.ts tests/integration/user-access-mutation-lock.integration.test.ts",
    "test:integration:provider-event-inbox": "PROVIDER_INBOX_TEST_COMMAND=true DEPLOYMENT_MODE=standalone vitest run --config vitest.integration.config.ts tests/integration/provider-event-inbox.test.ts",
    "db:setup:rls-test": "tsx scripts/setup-rls-test-db.ts",
    "db:setup:provider-event-inbox-test": "tsx scripts/setup-provider-event-inbox-test-db.ts",
    "db:setup:password-reset-e2e": "tsx scripts/setup-password-reset-e2e-db.ts",
    "test:e2e": "playwright test",
    "test:e2e:password-reset": "node scripts/run-password-reset-e2e.mjs",
    "mcp:playwright": "playwright-mcp --config ./playwright.mcp.config.json",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/run-prisma-migrate-deploy.mjs",
    "db:migrate:dev": "DEPLOYMENT_MODE=standalone prisma migrate dev",
    "db:push": "DEPLOYMENT_MODE=standalone prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "DEPLOYMENT_MODE=standalone prisma migrate reset",
    "db:studio": "DEPLOYMENT_MODE=standalone prisma studio",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "ops:backup-org": "tsx scripts/backup-org.ts",
    "ops:restore-org": "tsx scripts/restore-org.ts",
    "gdpr:export": "tsx scripts/gdpr-export.ts",
    "ops:grant-operator": "tsx scripts/grant-platform-operator.ts",
    "ops:verify-platform-operator": "tsx scripts/verify-platform-operators.ts",
    "rls:audit": "tsx scripts/rls-audit.ts",
    "worker": "tsx src/workers/index.ts",
    "worker:wake-delayed": "tsx src/workers/wakeDelayedJobs.ts",
    "worker:invitation-lifecycle": "tsx src/workers/invitationLifecycle.ts",
    "worker:password-reset-reconcile": "tsx src/workers/passwordResetReconciler.ts",
    "worker:password-reset-preflight": "tsx src/workers/passwordResetReconciler.ts --preflight",
    "worker:provider-event-preflight": "tsx src/workers/providerEventInboxPreflight.ts",
    "worker:send-pending-invites": "tsx src/workers/sendPendingInvites.ts",
    "worker:standalone": "DEPLOYMENT_MODE=standalone tsx src/workers/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/communication-sms": "^1.2.0-beta.4",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.31.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.25.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.13",
    "dxf-parser": "^1.1.2",
    "highlight.js": "^11.11.1",
    "ioredis": "^5.4.1",
    "jose": "^6.2.5",
    "lucide-react": "^0.460.0",
    "markdown-it": "^14.1.1",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.3",
    "react-virtuoso": "^4.18.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@babel/core": "^7.29.7",
    "@playwright/mcp": "^0.0.70",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^25.0.1",
    "postcss": "8.5.26",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "glob": "10.5.0",
    "brace-expansion@^2.0.0": "2.1.4",
    "brace-expansion@^5.0.0": "5.0.9",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.1",
    "linkify-it": "5.0.2",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "vite": "6.4.3",
    "jsdom": {
      "form-data": "4.0.6",
      "ws": "8.21.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    }
  },
  "sideEffects": [
    "*.css",
    "**/bigint-json.ts",
    "**/instrumentation.ts"
  ]
}
